{
  "name": "com.kikx.fetchtube",
  "title": "FetchTube",
  "version": "1.0.0",
  "author": "Fawz-Haaroon",
  "description": "Resolve a media link, inspect its formats, then play or download it.",
  "category": "Media",
  "kikx_version": "0.4.0",

  "include": ["public", "www", "micro"],

  "iframe": {
    "allowfullscreen": true,
    "sandbox": ["allow-scripts", "allow-downloads"],
    "allow": ["autoplay", "fullscreen", "picture-in-picture"]
  },

  "system": {
    "access": ["alerts"]
  },

  "services": ["micro", "kv", "fs"],

  "service_config": {
    "micro": {
      "extractor": {
        "main": "main.py",
        "stdout": true,
        "persistent": true
      }
    }
  },

  "theme": "dark"
}
